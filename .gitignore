# Python bytecode -- these were committed to the repository, so every run
# produced spurious "modified" entries in git status.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Written by the application at run time.
logs/*.log
logs/errors/*.log
analytics/*.txt
analytics/*.log
analytics/soliton-trials/

# macOS metadata (the Spring 24 copy is full of these).
._*
.DS_Store

# Raw sample data from live runs -- large, and regenerated by the tools.
logs/verification/*.json

# Camera clips and what was read from them -- large, and kept with the
# trial they belong to rather than in the repository.
logs/vision/
analytics/vision/
analytics/probes/
*.surface.npz
*.crest.png

# What a wavectl session writes: its own log and position samples.
logs/wavectl/

# The camera rig's recordings, caches and fits (tens of GB); see
# docs/VISION_HANDOFF.md. The fitting scripts worth keeping are in tools/analysis/.
analytics/rig/
